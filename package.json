{
  "name": "citizenpulse-brics",
  "private": true,
  "version": "1.0.0",
  "description": "CitizenPulse BRICS: From Citizen Voice to Infrastructure Intelligence",
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
